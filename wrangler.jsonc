{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link",
  "main": "./src/index.js",
  "compatibility_date": "2026-03-07",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "LINKS"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "cflink-files"
    }
  ],
  "vars": {
    "ADMIN_PATH": "/admin",
    "LONG_DOMAIN_BLACKLIST": "placeholder.invalid",
    "SUFFIX_BLACKLIST": "admin,login,api",
    "R2_ACCOUNT_ID": "c89d5b46d0bfd8edb3970c985da57b0a",
    "R2_BUCKET_NAME": "cflink-files"
  }
}
