{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cflink",
  "main": "./src/index.js",
  "compatibility_date": "2026-03-07",
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "LINKS"
    }
  ],
  "vars": {
    "ADMIN_PATH": "/admin",
    "ADMIN_PASS": "change-this-password",
    "LONG_DOMAIN_BLACKLIST": "placeholder.invalid",
    "SUFFIX_BLACKLIST": "admin,login,api"
  }
}
